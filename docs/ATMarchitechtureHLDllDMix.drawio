        <mxCell id="PzpG2bri5GxlcRA9Ap2d-167" parent="PzpG2bri5GxlcRA9Ap2d-134" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;b&gt;This withdrawAmount() method handles money withdrawal from an account.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;Connects to the database using DBConnection&lt;/div&gt;&lt;div&gt;Fetches the current account balance using getBalance()&lt;/div&gt;&lt;div&gt;Checks whether the account has sufficient balance&lt;/div&gt;&lt;div&gt;Returns false if balance is insufficient&lt;/div&gt;&lt;div&gt;Calculates the remaining balance after withdrawal&lt;/div&gt;&lt;div&gt;Executes an SQL UPDATE query to update the new balance in the database&lt;/div&gt;&lt;div&gt;Uses PreparedStatement for secure query execution&lt;/div&gt;&lt;div&gt;Returns:&lt;/div&gt;&lt;div&gt;true if withdrawal is successful&lt;/div&gt;&lt;div&gt;false if update fails or an exception occurs&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="200" width="460" x="10" y="30" as="geometry" />
        </mxCell>
        <mxCell id="PzpG2bri5GxlcRA9Ap2d-166" parent="PzpG2bri5GxlcRA9Ap2d-106" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;b&gt;This getBalance() method retrieves the account balance from the database.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Connects to the database using DBConnection&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Executes an SQL query to fetch the balance from the accounts table using the account number&lt;/div&gt;&lt;div&gt;Uses PreparedStatement for secure query execution&lt;/div&gt;&lt;div&gt;Stores the query result in ResultSet&lt;/div&gt;&lt;div&gt;Returns the account balance if the account exists&lt;/div&gt;&lt;div&gt;Returns 0 if no account is found or if an exception occurs&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="194" width="459" x="51" y="936" as="geometry" />
        </mxCell>
