        <mxCell id="PzpG2bri5GxlcRA9Ap2d-161" parent="PzpG2bri5GxlcRA9Ap2d-98" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;This DepositHandler class handles deposit API requests in the ATM application.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Implements HttpHandler to process HTTP requests&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Accepts only POST requests&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Reads deposit details from the request body using InputStream&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Converts JSON data into a DepositRequest object using Gson&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Calls AuthService to:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Deposit money into the account&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Fetch updated balance&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Sends JSON response:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&quot;Deposit Successful&quot; with updated balance if deposit succeeds&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&quot;Deposit Failed&quot; if transaction fails&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&quot;Invalid Request Method&quot; for non-POST requests&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Uses OutputStream to send the response back to the client&lt;/span&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="230" width="450" x="508" y="718" as="geometry" />
        </mxCell>
        <mxCell id="PzpG2bri5GxlcRA9Ap2d-106" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;code data-start=&quot;1072&quot; data-end=&quot;1077&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;dao&lt;/font&gt;&lt;/code&gt; Package (DAO = Data Access Object)" vertex="1">
          <mxGeometry height="1783" width="640" x="139" y="1104" as="geometry" />
