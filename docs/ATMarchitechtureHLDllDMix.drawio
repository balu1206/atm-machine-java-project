atabase%20operations%20layer%E2%80%9D%26lt%3B%2Fb%26gt%3B%26lt%3B%2Ffont%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3B%2Fblockquote%26gt%3B%22%20vertex%3D%221%22%3E%3CmxGeometry%20height%3D%22260%22%20width%3D%22490%22%20x%3D%22450%22%20y%3D%221117%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
