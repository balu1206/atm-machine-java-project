        <mxCell id="PzpG2bri5GxlcRA9Ap2d-160" collapsed="1" parent="PzpG2bri5GxlcRA9Ap2d-98" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;background-color: rgb(255, 255, 255); padding: 0px 0px 0px 2px;&quot;&gt;&lt;span style=&quot;font-family: Consolas; font-size: 10pt; white-space: pre;&quot;&gt;&lt;span style=&quot;background-color: rgb(212, 212, 212);&quot;&gt;depositeHandler.class&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;" vertex="1">
