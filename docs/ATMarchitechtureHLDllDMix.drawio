        <mxCell id="PzpG2bri5GxlcRA9Ap2d-143" parent="1" style="whiteSpace=wrap;html=1;align=left;" value="&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;div&gt;&lt;b&gt;This BalanceHandler class handles balance check API requests in the ATM application.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Implements HttpHandler to process HTTP requests&lt;/div&gt;&lt;div&gt;Accepts only POST requests&lt;/div&gt;&lt;div&gt;Reads JSON request data using InputStream&lt;/div&gt;&lt;div&gt;Converts JSON into BalanceRequest object using Gson&lt;/div&gt;&lt;div&gt;Calls AuthService to fetch account balance&lt;/div&gt;&lt;div&gt;Sends balance as a JSON response&lt;/div&gt;&lt;div&gt;Returns &quot;Invalid Request Method&quot; for non-POST requests&lt;/div&gt;&lt;div&gt;Uses OutputStream to send the response back to the client&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="220" width="460" x="930" y="410" as="geometry" />
        </mxCell>
        <mxCell id="PzpG2bri5GxlcRA9Ap2d-144" parent="1" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;This WithdrawHandler class handles money withdrawal API requests in the ATM application.&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Summary&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Implements HttpHandler to process HTTP requests&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Accepts only POST requests&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Reads withdrawal details from the request body using InputStream&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Converts JSON data into a WithdrawRequest object using Gson&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Calls AuthService to:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Withdraw amount from the account&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Fetch remaining balance&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Sends JSON response:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&quot;Withdrawal Successful&quot; with remaining balance if transaction succeeds&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&quot;Insufficient Balance&quot; if funds are not enough&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&quot;Invalid Request Method&quot; for non-POST requests&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Uses OutputStream to return the response to the client&lt;/font&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
