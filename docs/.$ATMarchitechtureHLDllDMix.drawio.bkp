        <mxCell id="PzpG2bri5GxlcRA9Ap2d-83" parent="PzpG2bri5GxlcRA9Ap2d-78" style="whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;Stores database details like&lt;/font&gt;&lt;/span&gt;&lt;ul&gt;&lt;li data-section-id=&quot;1l486py&quot; data-start=&quot;164&quot; data-end=&quot;178&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Database URL&lt;/font&gt;&lt;/li&gt;&lt;li data-section-id=&quot;rof1tq&quot; data-start=&quot;181&quot; data-end=&quot;191&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Username&lt;/font&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1i84dqv&quot; data-start=&quot;194&quot; data-end=&quot;204&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Password&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li data-section-id=&quot;8szo2c&quot; data-start=&quot;205&quot; data-end=&quot;258&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Loads the MySQL JDBC driver using &lt;code data-start=&quot;241&quot; data-end=&quot;258&quot;&gt;Class.forName()&lt;/code&gt;&lt;/font&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1p50l61&quot; data-start=&quot;259&quot; data-end=&quot;328&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Creates a database connection using &lt;code data-start=&quot;297&quot; data-end=&quot;328&quot;&gt;DriverManager.getConnection()&lt;/code&gt;&lt;/font&gt;&lt;/li&gt;&lt;li data-section-id=&quot;9zt86e&quot; data-start=&quot;329&quot; data-end=&quot;408&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Prints &lt;code data-start=&quot;338&quot; data-end=&quot;373&quot;&gt;&quot;Database Connected Successfully&quot;&lt;/code&gt; when the connection is established&lt;/font&gt;&lt;/li&gt;&lt;li data-section-id=&quot;cjs8vf&quot; data-start=&quot;409&quot; data-end=&quot;490&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Returns the &lt;code data-start=&quot;423&quot; data-end=&quot;435&quot;&gt;Connection&lt;/code&gt; object so other classes can interact with the database&lt;/font&gt;&lt;/li&gt;&lt;li data-section-id=&quot;fdftml&quot; data-start=&quot;491&quot; data-end=&quot;568&quot; data-is-last-node=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Handles exceptions using &lt;/span&gt;&lt;code data-start=&quot;518&quot; data-end=&quot;529&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;try-catch&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; and returns &lt;/span&gt;&lt;code data-start=&quot;542&quot; data-end=&quot;548&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;null&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; if connection fails&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
